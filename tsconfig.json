{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "paths": {
      "@sonogram/core": ["./packages/core/src/index.ts"],
      "@sonogram/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "examples/**/*",
    "*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ]
}
