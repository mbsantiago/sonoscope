---
interface Props {
  lang: string;
  filename: string;
  componentProps: Record<string, unknown>;
}
---

<div class="not-content live-code-card my-6">
  <div class="live-code-preview mb-4">
    <slot name="example" />
  </div>

  <details open class="group">
    <summary class="cursor-pointer select-none text-xs font-medium text-[var(--sl-color-gray-3)] hover:text-[var(--sl-color-text-accent)] mb-2 transition-colors">
      Source Code
    </summary>
    <div>
      <slot name="code" />
    </div>
  </details>
</div>

<style is:global>
  .live-code-card slot {
    display: block;
    width: 100%;
  }
</style>
