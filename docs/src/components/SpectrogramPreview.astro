---
import type { SpectrogramOptions } from "@sonoscope/core";

export interface Props {
  config?: SpectrogramOptions;
  height?: number | string;
  width?: number | string;
  class?: string;
}

const {
  config = {},
  height = 160,
  width = "100%",
  class: className,
} = Astro.props;

const configJson = JSON.stringify(config);
---

<spectrogram-preview
  data-config={configJson}
  class={`not-content ${className || ""}`}
  style={`display: block; width: ${typeof width === "number" ? `${width}px` : width}; height: ${typeof height === "number" ? `${height}px` : height}; margin: 8px 0;`}
>
  <canvas style="width: 100%; height: 100%; display: block; border-radius: 4px;"></canvas>
</spectrogram-preview>

<script>
  import "@sonoscope/halftone-spectrogram/auto";
  import "@sonoscope/terrain-spectrogram/auto";
  import "@sonoscope/topographic-spectrogram/auto";
  import { Sonoscope } from "@sonoscope/core";
  import { DEFAULT_AUDIO_URL } from "../constants";

  let sharedScopePromise: Promise<Sonoscope> | null = null;

  function getSharedScope(): Promise<Sonoscope> {
    if (!sharedScopePromise) {
      const audio = new Audio(DEFAULT_AUDIO_URL);
      sharedScopePromise = Sonoscope.fromUrl(DEFAULT_AUDIO_URL, { audio });
    }
    return sharedScopePromise;
  }

  class SpectrogramPreviewElement extends HTMLElement {
    private viewer: any = null;

    async connectedCallback() {
      const canvas = this.querySelector("canvas");
      if (!canvas) return;

      const config = this.dataset.config ? JSON.parse(this.dataset.config) : {};

      const scope = await getSharedScope();
      if (!this.isConnected) return;

      this.viewer = scope.createSpectrogram(canvas, {
        autoResize: true,
        ...config,
      });

      scope.attachNavigation(canvas);
    }

    disconnectedCallback() {
      this.viewer?.destroy();
      this.viewer = null;
    }
  }

  if (!customElements.get("spectrogram-preview")) {
    customElements.define("spectrogram-preview", SpectrogramPreviewElement);
  }
</script>
