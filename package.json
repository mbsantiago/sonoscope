{
  "name": "sonoscope-monorepo",
  "version": "0.1.0",
  "description": "High-performance WebGL2 and WASM-accelerated audio spectrogram visualization ecosystem.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && npm run --workspace=@sonoscope/core build && npm run --workspace=@sonoscope/ascii-spectrogram build && npm run --workspace=@sonoscope/halftone-spectrogram build && npm run --workspace=@sonoscope/terrain-spectrogram build && npm run --workspace=@sonoscope/topographic-spectrogram build && npm run --workspace=@sonoscope/react build && npm run --workspace=@sonoscope/anywidget build",
    "build:docs": "npm run --workspace=docs build",
    "build:examples": "vite build examples/basic --base=./",
    "dev:docs": "npm run --workspace=docs dev",
    "bench": "vitest bench",
    "fixtures:generate": "uv run scripts/generate_baseline_spectrograms.py",
    "capture:renderers": "node scripts/capture-renderers.mjs",
    "dev:example": "vite --host 127.0.0.1 examples/basic",
    "dev:ascii": "vite packages/ascii-spectrogram/demo",
    "test": "vitest run",
    "test:browser": "vitest run --config vite.browser.config.ts",
    "check:biome": "biome check",
    "check:types": "tsc --noEmit",
    "fix:format": "biome format --write",
    "fix:lint": "biome check --write",
    "fix:unsafe": "biome check --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "latest",
    "@vitest/browser-playwright": "latest",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.50.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "allowScripts": {
    "esbuild": true,
    "bs-logger": true,
    "mkdirp": true,
    "rimraf": true,
    "source-map-loader": true
  }
}
