{
  "name": "spectrogram-js",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "bench": "vitest bench",
    "capture:renderers": "node scripts/capture-renderers.mjs",
    "dev:example": "vite --host 127.0.0.1 examples/basic",
    "test": "vitest run",
    "test:browser": "vitest run --config vite.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/browser": "latest",
    "@vitest/browser-playwright": "latest",
    "pngjs": "^7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
