{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "scripts/**",
      "examples/**",
      "!packages/core/src/viewers/spectrogram/backends/wasm-stft-binary.ts",
      "!**/dist"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "includes": [
      "./packages/*/src/**/*.js",
      "./packages/*/src/**/*.ts",
      "./packages/*/src/**/*.tsx",
      "./scripts/**/*.mjs"
    ],
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": "info"
    }
  }
}
