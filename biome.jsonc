{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/anywidget/js/**",
      "scripts/**",
      "examples/**",
      "!packages/core/src/viewers/spectrogram/backends/wasm-stft-binary.ts",
      "!packages/anywidget/src/sonogram/static",
      "!**/dist"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "includes": [
      "packages/anywidget/js/*.ts",
      "./packages/*/src/**/*.js",
      "./packages/*/src/**/*.ts",
      "./packages/*/src/**/*.tsx",
      "./scripts/**/*.mjs"
    ],
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": "info"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": true
              }
            ]
          }
        }
      }
    }
  }
}
