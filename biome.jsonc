{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "examples/**",
      "!src/wasm-stft-binary.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "includes": ["./src/**/*.js", "./src/**/*.ts", "./scripts/**/*.mjs"],
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": "info"
    }
  }
}
